---
import ServiceCoverflow from "../ServiceCoverflow.tsx";

const servicesItems = [
  {
    text: "Presencia Digital",
    image: "/images/web.avif",
    description:
      "Webs que convierten visitantes en clientes. Diseño estratégico, rápido y optimizado para vender.",
  },
  {
    text: "Atención al Cliente Inteligente",
    image: "/images/ia.avif",
    description:
      "Automatización inteligente 24/7. Respuestas instantáneas, captura de leads y seguimiento sin aumentar tu equipo.",
  },
  {
    text: "Gestión Integrada",
    image: "/images/procesos.avif",
    description:
      "Centraliza tus operaciones. Pedidos, inventario y atención al cliente en un solo sistema.",
  },
];
---

<section class="services-section" id="servicios">
  <div class="services-inner">
    <div class="section-header">
      <h2 class="services-title">Servicios</h2>
    </div>

    <ServiceCoverflow client:load items={servicesItems} />
  </div>
</section>

<style>
  .services-section {
    padding: 75px 0;
    position: relative;
  }

  .services-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .section-header {
    text-align: center;
    margin-bottom: 48px;
  }

  .services-title {
    font-family: var(--font-sans);
    font-size: clamp(48.6px, 7.65vw, 97.2px);
    font-weight: 800;
    color: #f9cc15;
    line-height: 1.1;
    letter-spacing: -0.04em;
    margin-bottom: 16px;
  }

  @media (max-width: 768px) {
    .services-section {
      padding: 75px 0;
    }
  }
</style>
