---
import TrabajoWrapper from "../TrabajoWrapper.tsx";
---

<section class="trabajo-section" id="trabajo">
    <div class="section-header">
        <h2 class="trabajo-title">Nuestro trabajo</h2>
    </div>

    <TrabajoWrapper client:load />
</section>

<style>
    .trabajo-section {
        padding: 75px 0;
        position: relative;
        overflow: hidden;
    }

    .section-header {
        text-align: center;
        margin-bottom: 48px;
    }

    .trabajo-title {
        font-family: var(--font-sans);
        font-size: clamp(48.6px, 7.65vw, 97.2px);
        font-weight: 800;
        color: #f9cc15;
        line-height: 1.1;
        letter-spacing: -0.04em;
        margin-bottom: 16px;
    }

    @media (max-width: 768px) {
        .trabajo-section {
            padding: 75px 0;
        }
    }
</style>
