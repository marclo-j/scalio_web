---
import Layout from "../layouts/Layout.astro";
import Footer from "../components/Footer.astro";
import BackgroundGradient from "../components/BackgroundGradient.astro";

import Hero from "../components/sections/Hero.astro";
import Services from "../components/sections/Services.astro";
import Trabajo from "../components/sections/Trabajo.astro";
import Diferenciadores from "../components/sections/Diferenciadores.astro";
import Testimonials from "../components/sections/Testimonials.astro";
import CTA from "../components/sections/CTA.astro";
---

<Layout
  title="Scalio — Transformación Digital para tu Negocio"
  description="Agencia digital en Lima, Perú. Creamos páginas web que convierten visitantes en clientes y automatizamos tareas repetitivas para tu negocio."
  canonical="/"
>
  <div class="scroll-progress" id="scrollProgress"></div>

  <BackgroundGradient>
    <Hero />
    <Services />
    <Trabajo />
    <Diferenciadores />
    <Testimonials />
    <CTA />
    <Footer />
  </BackgroundGradient>

  <script>
    // Lazy-load GSAP only when the browser is idle to avoid blocking the initial
    // render. The whole animation bundle (gsap + ScrollTrigger) gets code-split
    // into its own chunk by Vite, so it never blocks the main thread on load.
    const loadAnimations = () =>
      import("../scripts/animations").then((m) => m.initAnimations());

    if ("requestIdleCallback" in window) {
      requestIdleCallback(loadAnimations, { timeout: 2000 });
    } else {
      setTimeout(loadAnimations, 1500);
    }
  </script>
</Layout>
